# Copy to `.env` and adjust. All values below are the defaults.

# Where the SQLite file lives. Override on hosts with a persistent disk,
# e.g. sqlite:////var/data/duolingo.db on Render.
# DATABASE_URL=sqlite:///./duolingo.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — only used by POST /api/exercise/explain (the AI hint route).
# Leave unset and that route returns a static fallback message; everything
# else works exactly the same.
ANTHROPIC_API_KEY=sk-ant-...
